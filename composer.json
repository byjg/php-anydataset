{
  "name": "byjg/anydataset",
  "description": "AnyDataset is a powerful data source abstraction layer for PHP that provides a simple and consistent interface to access different data sources. With AnyDataset, you can work with various data formats and storage systems using the same programming interface.",
  "autoload": {
    "psr-4": {
      "ByJG\\AnyDataset\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.3 <8.7",
    "ext-dom": "*",
    "byjg/xmlutil": "^7.0",
    "byjg/serializer": "^7.0"
  },
  "suggest": {
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "provide": {
    "byjg/anydataset-implementation": "1.0"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": [
      "@composer --working-dir=tools/psalm update --no-interaction",
      "tools/psalm/vendor/bin/psalm --threads=1"
    ]
  },
  "license": "MIT"
}
